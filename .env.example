# Il proxy (Vite o nginx) inoltra /api al backend togliendo il prefisso
VITE_API_URL=/api
# true = login, recenti e centrale usano i mock; la checklist richiede comunque il backend
VITE_USE_MOCKS=false

# --- npm run dev ---
API_PROXY_TARGET=http://localhost:3000

# --- docker-compose.yml / docker-compose.dev.yml ---
FRONTEND_PORT=8080
# host.docker.internal = la macchina host
BACKEND_URL=http://host.docker.internal:3000

