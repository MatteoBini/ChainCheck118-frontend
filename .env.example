# Base delle API: il proxy (Vite in sviluppo, nginx in Docker) inoltra /api al backend togliendo il prefisso
VITE_API_URL=/api
# true = usa i dati mockati in src/app/api/mock (nessun backend necessario)
VITE_USE_MOCKS=false

# --- npm run dev ---
# Backend ChainCheck118 raggiunto dal proxy di Vite
API_PROXY_TARGET=http://localhost:3000

# --- docker-compose.yml ---
FRONTEND_PORT=8080
# Backend raggiunto dal container nginx (in Docker Desktop: host.docker.internal = il tuo Mac)
BACKEND_URL=http://host.docker.internal:3000


# Con VITE_USE_MOCKS=false: il bundle non contiene né password123 né i nomi degli utenti di prova. Vite sostituisce il flag con una costante, quindi il ramo dei mock viene eliminato e non viene generato nemmeno il chunk.
# Con VITE_USE_MOCKS=true: i mock finiscono in un chunk separato di circa 1,5 kB, scaricato solo quando serve.